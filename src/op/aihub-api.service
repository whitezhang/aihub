[Unit]
Description=AiHub API (Node)
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/deploy/aihub
# blog=8080 / eduhub=8081 / aihub=8082
Environment=PORT=8082
Environment=NODE_ENV=production
Environment=AIHUB_ENV=production
# 生产库默认路径（可被 EnvironmentFile 覆盖）
Environment=DB_PATH=/var/lib/aihub/prod.sqlite
# 权威配置：src/op/conf/production.env（入库）
EnvironmentFile=-/root/deploy/aihub/src/op/conf/production.env
ExecStart=/usr/bin/node --experimental-sqlite --experimental-strip-types src/rd/server/index.ts
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
