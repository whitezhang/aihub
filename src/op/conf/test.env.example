# 本地测试配置（private 仓库入库）
# 使用：npm start / npm run dev —— 加载同目录 test.env

AIHUB_ENV=local
PORT=8082
# DB_PATH=                 # local 可省略，默认 src/rd/server/db/local.sqlite

INGEST_ENABLED=1
INGEST_TZ=Asia/Shanghai
INGEST_DAILY_AT=08:00
INGEST_RETRY_MINUTES=10
INGEST_RETENTION_DAYS=180
INGEST_LIMIT=30

# Product Hunt GraphQL（真实 upvote）
# PRODUCTHUNT_API_TOKEN=
# 或：
# PRODUCTHUNT_API_KEY=
# PRODUCTHUNT_API_SECRET=

# GITHUB_TOKEN=
