# 生产配置（private 仓库入库；部署：bash src/op/deploy.sh）
# 也可从本模板复制：cp production.env.example production.env

AIHUB_ENV=production
PORT=8082
DB_PATH=/var/lib/aihub/prod.sqlite

INGEST_ENABLED=1
INGEST_TZ=Asia/Shanghai
INGEST_DAILY_AT=08:00
INGEST_RETRY_MINUTES=10
INGEST_RETENTION_DAYS=180
INGEST_LIMIT=30

# Product Hunt GraphQL（必填其一：TOKEN，或 KEY+SECRET）
# PRODUCTHUNT_API_TOKEN=
PRODUCTHUNT_API_KEY=
PRODUCTHUNT_API_SECRET=

# GITHUB_TOKEN=
