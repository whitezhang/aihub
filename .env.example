# Copy to .env locally / on server. Never commit real secrets.
# 生产：AIHUB_ENV=production，且必须设独立 DB_PATH（见 src/op/aihub-api.service）。

AIHUB_ENV=local
PORT=8082
# DB_PATH=                 # local 可省略；production 必填，如 /var/lib/aihub/prod.sqlite

INGEST_ENABLED=1
INGEST_TZ=Asia/Shanghai
INGEST_DAILY_AT=08:00
INGEST_RETRY_MINUTES=10
INGEST_RETENTION_DAYS=180
INGEST_LIMIT=30

# Product Hunt GraphQL (preferred for real upvotes)
# Either developer token:
# PRODUCTHUNT_API_TOKEN=
# Or OAuth app key/secret (client_credentials):
# PRODUCTHUNT_API_KEY=
# PRODUCTHUNT_API_SECRET=

# Optional GitHub API token
# GITHUB_TOKEN=
